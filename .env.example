# Supabase PostgreSQL
# DATABASE_URL: Supavisor transaction pooler，提供 Next.js 執行時使用
# DIRECT_URL: Supabase direct connection，提供 Prisma migration 使用
# 請在 Supabase Dashboard > Connect > ORMs / Node.js 複製連線字串，並替換密碼。
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Next.js 運行環境設定
NODE_ENV="development"
