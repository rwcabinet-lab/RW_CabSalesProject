generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  role                Role               @default(SALES)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  customers           Customer[]         @relation("SalesRepCustomers")
  milestones          ProjectMilestone[]
  projectsAsAssistant Project[]          @relation("ProjectAssistant")
  projectsAsSalesRep  Project[]          @relation("ProjectSalesRep")
  tasks               SalesTask[]        @relation("TaskAssignee")
  assignedTasks       SalesTask[]        @relation("TaskAssigner")

  @@map("users")
}

model RolePageAccess {
  role  Role     @id
  pages String[] @default([])

  @@map("role_page_access")
}

model Customer {
  id              String       @id @default(cuid())
  customerType    CustomerType @map("customer_type")
  name            String
  taxId           String?      @map("tax_id")
  phone           String
  address         String?
  defaultDiscount Decimal      @default(1.00) @map("default_discount") @db.Decimal(5, 2)
  paymentTerms    PaymentTerms @default(DEPOSIT_BALANCE) @map("payment_terms")
  salesRepId      String       @map("sales_rep_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  salesRep        User         @relation("SalesRepCustomers", fields: [salesRepId], references: [id])
  projects        Project[]

  @@map("customers")
}

model MasterBoard {
  id          String   @id @default(cuid())
  brand       String
  colorCode   String   @map("color_code")
  thicknessMm Int      @map("thickness_mm")
  grade       String
  unit        String   @default("才")
  retailPrice Decimal  @map("retail_price") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([brand, thicknessMm])
  @@map("master_boards")
}

model MasterHardware {
  id          String           @id @default(cuid())
  brand       String
  modelName   String           @map("model_name")
  category    HardwareCategory
  retailPrice Decimal          @map("retail_price") @db.Decimal(10, 2)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([category, brand])
  @@map("master_hardware")
}

model MasterProcessing {
  id          String   @id @default(cuid())
  processName String   @map("process_name")
  unit        String
  retailPrice Decimal  @map("retail_price") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("master_processing")
}

enum ProjectStage {
  INQUIRY
  MEASUREMENT
  QUOTE
  CONTRACT
  CAD_DRAWING
  HANDOFF
  DONE
  CONTACT
  DESIGN
  PRODUCTION
  CLOSED
  BILLED
  WRAP_UP
  LOST
}

model Project {
  id               String             @id @default(cuid())
  projectName      String             @map("project_name")
  customerId       String             @map("customer_id")
  siteAddress      String             @map("site_address")
  siteCondition    String?            @map("site_condition")
  salesRepId       String             @map("sales_rep_id")
  salesAssistantId String?            @map("sales_assistant_id")
  currentStage     ProjectStage       @default(CONTACT) @map("current_stage")
  isDelayed        Boolean            @default(false) @map("is_delayed")
  expectedDate     DateTime?          @map("expected_date")
  estimatedBudget  Decimal?           @map("estimated_budget") @db.Decimal(12, 2)
  unitCount        Int?               @map("unit_count")
  cost             Decimal?           @db.Decimal(12, 2)
  quoteAmount      Decimal?           @map("quote_amount") @db.Decimal(12, 2)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  milestones       ProjectMilestone[]
  customer         Customer           @relation(fields: [customerId], references: [id])
  salesAssistant   User?              @relation("ProjectAssistant", fields: [salesAssistantId], references: [id])
  salesRep         User               @relation("ProjectSalesRep", fields: [salesRepId], references: [id])
  quotations       Quotation[]
  tasks            SalesTask[]

  @@index([currentStage, isDelayed])
  @@map("projects")
}

model ProjectMilestone {
  id             String          @id @default(cuid())
  projectId      String          @map("project_id")
  stageCode      String          @map("stage_code")
  phase          String          @default("CONTACT")
  stageOrder     Int             @default(1) @map("stage_order")
  plannedDueDate DateTime?       @map("planned_due_date")
  actualDueDate  DateTime?       @map("actual_due_date")
  status         MilestoneStatus @default(PENDING)
  priority       TaskPriority    @default(MEDIUM)
  assignedToId   String?         @map("assigned_to_id")
  attachments    String?
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  assignedTo     User?           @relation(fields: [assignedToId], references: [id])
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesTask      SalesTask?

  @@index([status, plannedDueDate])
  @@map("project_milestones")
}

model Quotation {
  id           String         @id @default(cuid())
  projectId    String         @map("project_id")
  version      String         @default("V1")
  externalQuoteNo String?     @map("external_quote_no")
  quoteFileUrl  String?       @map("quote_file_url")
  notes        String?
  discountRate Decimal        @default(1.00) @map("discount_rate") @db.Decimal(5, 2)
  rawSubtotal  Decimal        @default(0) @map("raw_subtotal") @db.Decimal(12, 2)
  taxAmount    Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount  Decimal        @default(0) @map("total_amount") @db.Decimal(12, 2)
  status       QuoteStatus    @default(DRAFT)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cabinets     QuoteCabinet[]

  @@map("quotations")
}

model QuoteCabinet {
  id              String           @id @default(cuid())
  quoteId         String           @map("quote_id")
  areaZone        String           @map("area_zone")
  cabinetName     String           @map("cabinet_name")
  dimensions      String
  cabinetSubtotal Decimal          @default(0) @map("cabinet_subtotal") @db.Decimal(12, 2)
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  quote           Quotation        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  components      QuoteComponent[]

  @@map("quote_cabinets")
}

model QuoteComponent {
  id            String        @id @default(cuid())
  cabinetItemId String        @map("cabinet_item_id")
  componentType ComponentType @map("component_type")
  itemNameSpec  String        @map("item_name_spec")
  thickness     Int?
  quantity      Decimal       @db.Decimal(10, 2)
  unit          String
  unitPrice     Decimal       @map("unit_price") @db.Decimal(10, 2)
  subtotal      Decimal       @db.Decimal(12, 2)
  notes         String?
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  cabinet       QuoteCabinet  @relation(fields: [cabinetItemId], references: [id], onDelete: Cascade)

  @@map("quote_components")
}

model SalesTask {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  assignedToId String       @map("assigned_to_id")
  assignedById String?      @map("assigned_by_id")
  taskType     TaskType     @map("task_type")
  subject      String
  dueDatetime  DateTime     @map("due_datetime")
  priority     TaskPriority @default(MEDIUM)
  isCompleted  Boolean      @default(false) @map("is_completed")
  resultNotes  String?      @map("result_notes")
  completedAt  DateTime?    @map("completed_at")
  milestoneId  String?      @unique @map("milestone_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedBy   User?        @relation("TaskAssigner", fields: [assignedById], references: [id])
  milestone    ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([isCompleted, dueDatetime])
  @@map("sales_tasks")
}

enum Role {
  ADMIN
  LEVEL_MANAGER
  SALES_MANAGER
  SALES
  ASSISTANT
}

enum CustomerType {
  LONGMEI_STORE
  CABINET_FACTORY
  DESIGN_COMPANY
  DEALER_COMPANY
  CONSTRUCTION
  LABOR_MATERIAL
  INDIVIDUAL
  DESIGNER
  CONTRACTOR
  DEALER
  HOMEOWNER
}

enum PaymentTerms {
  CASH
  MONTHLY_30
  DEPOSIT_BALANCE
}

enum HardwareCategory {
  HINGE
  SLIDE
  PULLOUT
  HANDLE
  ACCESSORY
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ComponentType {
  BOARD
  HARDWARE
  PROCESSING
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskType {
  SITE_VISIT
  DRAWING
  QUOTE_FOLLOWUP
  PAYMENT_REMINDER
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}
