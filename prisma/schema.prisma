generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  role                Role               @default(SALES)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  customers           Customer[]         @relation("SalesRepCustomers")
  milestones          ProjectMilestone[]
  projectsAsAssistant Project[]          @relation("ProjectAssistant")
  projectsAsSalesRep  Project[]          @relation("ProjectSalesRep")
  tasks               SalesTask[]        @relation("TaskAssignee")
  assignedTasks       SalesTask[]        @relation("TaskAssigner")
  milestoneRecords    MilestoneRecord[]

  @@map("users")
}

model RolePageAccess {
  role  Role     @id
  pages String[] @default([])

  @@map("role_page_access")
}

model Customer {
  id              String       @id @default(cuid())
  customerType    CustomerType @map("customer_type")
  name            String
  taxId           String?      @map("tax_id")
  phone           String
  address         String?
  defaultDiscount Decimal      @default(1.00) @map("default_discount") @db.Decimal(5, 2)
  paymentTerms    PaymentTerms @default(DEPOSIT_BALANCE) @map("payment_terms")
  salesRepId      String       @map("sales_rep_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  salesRep        User         @relation("SalesRepCustomers", fields: [salesRepId], references: [id])
  projects        Project[]

  @@index([salesRepId])
  @@index([taxId])
  @@index([phone])
  @@index([createdAt(sort: Desc)])
  @@map("customers")
}

enum ProjectStage {
  INQUIRY
  MEASUREMENT
  QUOTE
  CONTRACT
  CAD_DRAWING
  HANDOFF
  DONE
  CONTACT
  DESIGN
  PRODUCTION
  CLOSED
  BILLED
  WRAP_UP
  LOST
  DEVELOP
  REQUIREMENT
  PROPOSAL
  PRE_PROD
  PROD_SHIP
  INSTALL
  CLOSURE
}

model Project {
  id               String             @id @default(cuid())
  projectName      String             @map("project_name")
  customerId       String             @map("customer_id")
  siteAddress      String             @map("site_address")
  siteCondition    String?            @map("site_condition")
  salesRepId       String             @map("sales_rep_id")
  salesAssistantId String?            @map("sales_assistant_id")
  currentStage     ProjectStage       @default(CONTACT) @map("current_stage")
  isDelayed        Boolean            @default(false) @map("is_delayed")
  expectedDate     DateTime?          @map("expected_date")
  estimatedBudget  Decimal?           @map("estimated_budget") @db.Decimal(12, 2)
  unitCount        Int?               @map("unit_count")
  cost             Decimal?           @db.Decimal(12, 2)
  quoteAmount      Decimal?           @map("quote_amount") @db.Decimal(12, 2)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  milestones       ProjectMilestone[]
  customer         Customer           @relation(fields: [customerId], references: [id])
  salesAssistant   User?              @relation("ProjectAssistant", fields: [salesAssistantId], references: [id])
  salesRep         User               @relation("ProjectSalesRep", fields: [salesRepId], references: [id])
  tasks            SalesTask[]

  @@index([currentStage, isDelayed])
  @@index([expectedDate])
  @@index([customerId])
  @@index([salesRepId])
  @@index([salesAssistantId])
  @@index([createdAt(sort: Desc)])
  @@index([salesRepId, createdAt(sort: Desc)])
  @@index([salesAssistantId, createdAt(sort: Desc)])
  @@map("projects")
}

model ProjectMilestone {
  id             String            @id @default(cuid())
  projectId      String            @map("project_id")
  stageCode      String            @map("stage_code")
  phase          String            @default("DEVELOP")
  stageOrder     Int               @default(1) @map("stage_order")
  plannedDueDate DateTime?         @map("planned_due_date")
  actualDueDate  DateTime?         @map("actual_due_date")
  status         MilestoneStatus   @default(PENDING)
  priority       TaskPriority      @default(MEDIUM)
  assignedToId   String?           @map("assigned_to_id")
  attachments    String?
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  assignedTo     User?             @relation(fields: [assignedToId], references: [id])
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  salesTask      SalesTask?
  records        MilestoneRecord[]

  @@index([projectId])
  @@index([projectId, stageOrder])
  @@index([projectId, stageCode])
  @@index([assignedToId])
  @@index([assignedToId, projectId])
  @@index([status, plannedDueDate])
  @@index([plannedDueDate, status])
  @@map("project_milestones")
}

model MilestoneRecord {
  id             String           @id @default(cuid())
  milestoneId    String           @map("milestone_id")
  recordOrder    Int              @default(1) @map("record_order")
  plannedDueDate DateTime?        @map("planned_due_date")
  actualDueDate  DateTime?        @map("actual_due_date")
  amount         Decimal?         @db.Decimal(12, 2)
  notes          String?
  assignedToId   String?          @map("assigned_to_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  milestone      ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignedTo     User?            @relation(fields: [assignedToId], references: [id])

  @@index([milestoneId])
  @@index([assignedToId])
  @@map("milestone_records")
}

model AppConfig {
  id        String   @id @default("global")
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_configs")
}

model SalesTask {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  assignedToId String       @map("assigned_to_id")
  assignedById String?      @map("assigned_by_id")
  taskType     TaskType     @map("task_type")
  subject      String
  dueDatetime  DateTime     @map("due_datetime")
  priority     TaskPriority @default(MEDIUM)
  isCompleted  Boolean      @default(false) @map("is_completed")
  resultNotes  String?      @map("result_notes")
  completedAt  DateTime?    @map("completed_at")
  milestoneId  String?      @unique @map("milestone_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedBy   User?        @relation("TaskAssigner", fields: [assignedById], references: [id])
  milestone    ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assignedToId, isCompleted])
  @@index([assignedById])
  @@index([assignedToId])
  @@index([assignedToId, projectId])
  @@index([isCompleted, dueDatetime])
  @@map("sales_tasks")
}

enum Role {
  ADMIN
  LEVEL_MANAGER
  SALES_MANAGER
  SALES
  ASSISTANT
  SITE_ENGINEER
}

enum CustomerType {
  LONGMEI_STORE
  CABINET_FACTORY
  DESIGN_COMPANY
  DEALER_COMPANY
  CONSTRUCTION
  LABOR_MATERIAL
  INDIVIDUAL
  DESIGNER
  CONTRACTOR
  DEALER
  HOMEOWNER
}

enum PaymentTerms {
  CASH
  MONTHLY_30
  DEPOSIT_BALANCE
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskType {
  SITE_VISIT
  DRAWING
  QUOTE_FOLLOWUP
  PAYMENT_REMINDER
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}
